# Postgres (docker compose overrides this for the app container)
DATABASE_URL=postgres://app:app@localhost:5432/app

# Gemini via the AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# GitHub Issues (fine-grained PAT with Issues read/write). Leave blank to skip issue creation.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

PORT=3000
